    {
      "mode": "managed",
      "type": "local_file",
      "name": "gitops",
      "provider": "provider[\"registry.terraform.io/hashicorp/local\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "content": "# Argo CD déploie l'app par digest depuis Git (pull-based, self-heal).\napiVersion: argoproj.io/v1alpha1\nkind: Application\nmetadata:\n  name: itssolutions-app\n  namespace: openshift-gitops\nspec:\n  project: default\n  source:\n    repoURL: https://github.com/florient2016/aws-openshift-cicd-ecr.git\n    targetRevision: main\n    path: gitops\n  destination:\n    server: https://kubernetes.default.svc\n    namespace: app-prod\n  syncPolicy:\n    automated:\n      prune: true\n      selfHeal: true\n    syncOptions:\n      - CreateNamespace=true\n",
            "content_base64": null,
            "content_base64sha256": "6Ll9eqmt7eCjVLSeAkHhrao3CwwN4M9dZxxxx4S2sZg=",
            "content_base64sha512": "AzqWsSs/CQPf6JR2hoNkX9/6G/fZ0rg+NSgeV9Pa/Izo6qtSIwZ2fpdDzaSKRCvrijVtGw4mgq5NAX+hBPnIPg==",
            "content_md5": "ee164689cd1a0f7a292a0cf5f70a453f",
            "content_sha1": "4e35b3edcb42adc8c5d106dd278b36b5fe3dd46e",
            "content_sha256": "e8b97d7aa9adede0a354b49e0241e1adaa370b0c0de0cf5d671c71c784b6b198",
            "content_sha512": "033a96b12b3f0903dfe894768683645fdffa1bf7d9d2b83e35281e57d3dafc8ce8eaab522306767e9743cda48a442beb8a356d1b0e2682ae4d017fa104f9c83e",
            "directory_permission": "0777",
            "file_permission": "0777",
            "filename": "./rendered/gitops.yaml",
            "id": "4e35b3edcb42adc8c5d106dd278b36b5fe3dd46e",
            "sensitive_content": null,
            "source": null
          },
          "sensitive_attributes": [
