    {
      "mode": "managed",
      "type": "local_file",
      "name": "admission",
      "provider": "provider[\"registry.terraform.io/hashicorp/local\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "content": "# Supply-chain gate (natif, sans opérateur) : refuse toute image hors de notre ECR.\n# Requiert OCP \u003e= 4.17 (VAP GA). Sur 4.16, remplacer v1 par v1beta1.\n---\napiVersion: admissionregistration.k8s.io/v1\nkind: ValidatingAdmissionPolicy\nmetadata:\n  name: only-itssolutions-ecr\nspec:\n  failurePolicy: Fail\n  matchConstraints:\n    resourceRules:\n      - apiGroups: [\"\"]\n        apiVersions: [\"v1\"]\n        operations: [\"CREATE\", \"UPDATE\"]\n        resources: [\"pods\"]\n  validations:\n    - expression: \u003e\n        object.spec.containers.all(c, c.image.startsWith(\"381492204241.dkr.ecr.us-east-1.amazonaws.com/\")) \u0026\u0026\n        (!has(object.spec.initContainers) ||\n         object.spec.initContainers.all(c, c.image.startsWith(\"381492204241.dkr.ecr.us-east-1.amazonaws.com/\")))\n      message: \"Image refusée : seules les images de 381492204241.dkr.ecr.us-east-1.amazonaws.com/ sont autorisées (supply-chain itssolutions).\"\n---\napiVersion: admissionregistration.k8s.io/v1\nkind: ValidatingAdmissionPolicyBinding\nmetadata:\n  name: only-itssolutions-ecr-binding\nspec:\n  policyName: only-itssolutions-ecr\n  validationActions: [\"Deny\"]\n  matchResources:\n    namespaceSelector:\n      matchLabels:\n        supply-chain: enforced\n",
            "content_base64": null,
            "content_base64sha256": "29S/J6pSkwNbPhMwNLSVM1hVkJ4749cfOQ6Tz7tOEME=",
            "content_base64sha512": "2uid/r7m1B3FWQozmhRN+AOiLrLdRO8IhzuE/Za1o9masDnh96gBT7F/Miawuv9pICHGJSyZOIEceOm+7H/IYA==",
            "content_md5": "48fac3fa13835d57b9c01629743ef4ba",
            "content_sha1": "eb3c4ba6084856699e239a38a065b7ac887d8e11",
            "content_sha256": "dbd4bf27aa5293035b3e133034b495335855909e3be3d71f390e93cfbb4e10c1",
            "content_sha512": "dae89dfebee6d41dc5590a339a144df803a22eb2dd44ef08873b84fd96b5a3d99ab039e1f7a8014fb17f3226b0baff692021c6252c9938811c78e9beec7fc860",
            "directory_permission": "0777",
